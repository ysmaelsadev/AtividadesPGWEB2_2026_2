<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Minha Estante — organize e acompanhe suas leituras.">
    <title><%= tituloPagina %> | Minha Estante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              canvas: "#F6F8F5",
              ink: "#17221E",
              forest: "#315C4E",
              sage: "#DCE9E3",
              mist: "#E9EEEA",
              clay: "#C66D4E"
            },
            boxShadow: {
              soft: "0 18px 50px rgba(34, 62, 52, 0.08)"
            }
          }
        }
      };
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink antialiased selection:bg-sage">
    <header class="border-b border-ink/10 bg-canvas/95">
      <nav class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-5 sm:flex-row sm:px-8" aria-label="Navegação principal">
        <a href="/" class="flex items-center gap-3 text-lg font-semibold tracking-tight text-ink">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-forest text-sm font-bold text-white" aria-hidden="true">ME</span>
          Minha Estante
        </a>
        <menu class="flex flex-wrap items-center justify-center gap-1 text-sm font-medium text-ink/70">
          <li><a class="block rounded-full px-4 py-2 transition hover:bg-white hover:text-forest" href="/">Início</a></li>
          <li><a class="block rounded-full px-4 py-2 transition hover:bg-white hover:text-forest" href="/livros">Minha coleção</a></li>
          <li><a class="ml-1 block rounded-full border border-forest px-4 py-2 text-forest transition hover:bg-forest hover:text-white" href="/livros/novo">Adicionar livro</a></li>
        </menu>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-5 py-10 sm:px-8 sm:py-14">

