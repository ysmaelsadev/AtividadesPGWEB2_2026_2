<%- include("partials/header") %>

<header class="flex flex-col justify-between gap-6 border-b border-ink/10 pb-9 sm:flex-row sm:items-end">
  <hgroup>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest">Sua biblioteca</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] text-ink sm:text-5xl">Minha coleção</h1>
    <p class="mt-3 max-w-lg text-ink/55">Um panorama simples de tudo que você está lendo e já concluiu.</p>
  </hgroup>
  <a href="/livros/novo" class="inline-flex items-center justify-center gap-2 rounded-full bg-forest px-5 py-3 font-semibold text-white transition hover:bg-ink">
    <span class="text-xl font-light leading-none" aria-hidden="true">+</span> Adicionar livro
  </a>
</header>

<section class="grid border-b border-ink/10 py-8 sm:grid-cols-3" aria-label="Resumo da estante">
  <article class="border-b border-ink/10 py-5 sm:border-b-0 sm:border-r sm:px-7 sm:py-1 sm:first:pl-0">
    <strong class="text-4xl font-semibold tracking-tight text-ink"><%= resumo.total %></strong>
    <p class="mt-1 text-sm text-ink/50">livros na coleção</p>
  </article>
  <article class="border-b border-ink/10 py-5 sm:border-b-0 sm:border-r sm:px-7 sm:py-1">
    <strong class="text-4xl font-semibold tracking-tight text-forest"><%= resumo.lidos %></strong>
    <p class="mt-1 text-sm text-ink/50">leituras concluídas</p>
  </article>
  <article class="py-5 sm:px-7 sm:py-1">
    <strong class="text-4xl font-semibold tracking-tight text-clay"><%= resumo.paginasLidas %></strong>
    <p class="mt-1 text-sm text-ink/50">páginas lidas</p>
  </article>
</section>

<% if (livros.length === 0) { %>
  <section class="my-12 rounded-[2rem] border border-dashed border-forest/30 bg-sage/40 px-6 py-16 text-center">
    <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-white text-xl text-forest" aria-hidden="true">+</span>
    <h2 class="mt-5 text-2xl font-semibold tracking-tight">Comece sua coleção</h2>
    <p class="mx-auto mt-2 max-w-sm text-ink/55">Sua estante ainda está vazia. Adicione o primeiro livro para começar a acompanhar suas leituras.</p>
    <a href="/livros/novo" class="mt-6 inline-flex rounded-full bg-forest px-5 py-3 font-semibold text-white hover:bg-ink">Adicionar primeiro livro</a>
  </section>
<% } else { %>
  <section class="mt-10" aria-labelledby="lista-livros">
    <header class="mb-4 flex items-center justify-between">
      <h2 id="lista-livros" class="text-sm font-semibold uppercase tracking-[0.16em] text-ink/45">Todos os livros</h2>
      <p class="text-sm text-ink/40"><%= livros.length %> <%= livros.length === 1 ? "item" : "itens" %></p>
    </header>

    <section class="overflow-hidden rounded-2xl border border-ink/10 bg-white">
      <% livros.forEach((livro, index) => { %>
        <article class="grid gap-5 border-b border-ink/10 p-5 last:border-b-0 sm:grid-cols-[3rem_1fr_auto] sm:items-center sm:p-6">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-mist text-sm font-semibold text-forest" aria-hidden="true"><%= String(index + 1).padStart(2, "0") %></span>

          <section class="min-w-0">
            <header class="flex flex-wrap items-center gap-3">
              <h3 class="text-lg font-semibold tracking-tight text-ink"><%= livro.titulo %></h3>
              <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= livro.status === 'Lido' ? 'bg-sage text-forest' : 'bg-orange-50 text-clay' %>">
                <span class="h-1.5 w-1.5 rounded-full <%= livro.status === 'Lido' ? 'bg-forest' : 'bg-clay' %>" aria-hidden="true"></span>
                <%= livro.status %>
              </span>
            </header>
            <p class="mt-1.5 text-sm text-ink/50"><%= livro.autor %> <span class="mx-2 text-ink/20">•</span> <%= livro.paginas %> páginas</p>
          </section>

          <menu class="flex flex-wrap items-center gap-2 sm:justify-end">
            <li>
              <a href="/livros/status/<%= index %>" class="block rounded-full border border-forest/20 px-4 py-2 text-center text-sm font-semibold text-forest transition hover:bg-sage">
                <%= livro.status === "Lido" ? "Voltar a ler" : "Concluir leitura" %>
              </a>
            </li>
            <li>
              <a href="/livros/remover/<%= index %>" onclick="return confirm('Deseja excluir este livro da sua estante?')" class="block rounded-full px-3 py-2 text-sm font-medium text-ink/40 transition hover:bg-red-50 hover:text-red-700">Excluir</a>
            </li>
          </menu>
        </article>
      <% }) %>
    </section>
  </section>
<% } %>

<%- include("partials/footer") %>

